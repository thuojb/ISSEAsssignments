CC = gcc
CFLAGS = -Wall -Werror -std=c99 -g -fsanitize=address
LDFLAGS = -fsanitize=address

SRCS = expr_whizz.c expr_tree.c parse.c tokenize.c cdict.c clist.c
OBJS = $(SRCS:.c=.o)
TARGET = expr_whizz

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(LDFLAGS) -o $@ $^

%.o: %.c
	$(CC) $(CFLAGS) -c $<

clean:
	rm -f $(OBJS) $(TARGET)
