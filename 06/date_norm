#!/bin/bash

# function to process the input
process_dates() {
  sed -E -f <(cat << 'EOF'
# Convert all types of dates to a temporary format first
# DD/MM/YYYY or D/M/YYYY to @YYYY#MM#DD@
s/([0-9]{1,2})\/([0-9]{1,2})\/([0-9]{4})/@\3#\2#\1@/g

# DD-MM-YYYY or D-M-YYYY to @YYYY#MM#DD@
s/([0-9]{1,2})-([0-9]{1,2})-([0-9]{4})/@\3#\2#\1@/g

# DD MM YYYY or D M YYYY to @YYYY#MM#DD@
s/([0-9]{1,2})[ \t]+([0-9]{1,2})[ \t]+([0-9]{4})/@\3#\2#\1@/g

# Month name with day (and optional comma)
s/\b([0-9]{1,2})[ \t]*(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)[ \t]*(,?)[ \t]*([0-9]{4})\b/@\4#\2#\1@/gi

# Month name D, YYYY or Month name DD, YYYY
s/\b(January|February|March|April|May|June|July|August|September|October|November|December|Jan|Feb|Mar|Apr|Jun|Jul|Aug|Sep|Sept|Oct|Nov|Dec)[ \t]+([0-9]{1,2})(,?)[ \t]+([0-9]{4})\b/@\4#\1#\2@/gi

# Convert month names to numbers in our temporary format
s/#([Jj][Aa][Nn](uary)?)#/#01#/g
s/#([Ff][Ee][Bb](ruary)?)#/#02#/g
s/#([Mm][Aa][Rr](ch)?)#/#03#/g
s/#([Aa][Pp][Rr](il)?)#/#04#/g
s/#([Mm][Aa][Yy])#/#05#/g
s/#([Jj][Uu][Nn](e)?)#/#06#/g
s/#([Jj][Uu][Ll](y)?)#/#07#/g
s/#([Aa][Uu][Gg](ust)?)#/#08#/g
s/#([Ss][Ee][Pp](tember)?)#/#09#/g
s/#([Oo][Cc][Tt](ober)?)#/#10#/g
s/#([Nn][Oo][Vv](ember)?)#/#11#/g
s/#([Dd][Ee][Cc](ember)?)#/#12#/g

# Pad single-digit months and days with zeros
s/@([0-9]{4})#([0-9])#/@\1#0\2#/g
s/#([0-9])@/#0\1@/g

# Validate dates
# February
s/@([0-9]{4})#02#(3[01]|30)@/INVALID/g
# Months with 30 days
s/@([0-9]{4})#(04|06|09|11)#31@/INVALID/g
# Invalid days
s/@([0-9]{4})#([0-9]{2})#(3[2-9]|[4-9][0-9]|00)@/INVALID/g
# Invalid months
s/@([0-9]{4})#(1[3-9]|2[0-9][0-9]|00)#([0-9]{2})@/INVALID/g

# Convert valid dates to final format
s/@([0-9]{4})#([0-9]{2})#([0-9]{2})@/\1--\2--\3/g

# Remove INVALID marker and restore original text
s/INVALID/\0/g
EOF
  )
}

if [ $# -eq 0 ]; then
    # processing standard input for first arg
    process_dates
elif [ $# -eq 1 ]; then
    # processing file in-place for first arg
    if [ ! -f "$1" ]; then
        echo "Error: File $1 does not exist." >&2
        exit 1
    fi
    
    # create backup file
    cp "$1" "$1.BAK"
    
    # process file and save to temporary file
    temp_file=$(mktemp)
    process_dates < "$1" > "$temp_file"
    
    # move temporary file to original filename
    mv "$temp_file" "$1"
else
    echo "Usage: $0 [filename]" >&2
    exit 1
fi